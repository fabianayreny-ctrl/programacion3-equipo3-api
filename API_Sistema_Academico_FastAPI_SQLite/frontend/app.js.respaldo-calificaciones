// FORMULARIO PARA CREAR MATRICULAS
async function inicializarFormularioMatricula() {
  const formulario = document.getElementById("formulario-nueva-matricula");
  const estudiantesSelect = document.getElementById("matricula-estudiante");
  const seccionesSelect = document.getElementById("matricula-seccion");
  const mensaje = document.getElementById("mensaje-nueva-matricula");
  const boton = document.getElementById("boton-guardar-matricula");

  if (!formulario || formulario.dataset.inicializado === "si") return;
  formulario.dataset.inicializado = "si";

  const cargarOpciones = async () => {
    mensaje.textContent = "Cargando estudiantes y secciones...";
    estudiantesSelect.replaceChildren();
    seccionesSelect.replaceChildren();

    try {
      const [resEstudiantes, resSecciones] = await Promise.all([
        apiFetch(`${URL_BASE_API}/estudiantes`),
        apiFetch(`${URL_BASE_API}/secciones/disponibles`)
      ]);

      if (!resEstudiantes.ok) throw new Error("No se pudieron cargar los estudiantes (HTTP " + resEstudiantes.status + ").");
      if (!resSecciones.ok) throw new Error("No se pudieron cargar las secciones (HTTP " + resSecciones.status + ").");

      const estudiantes = await resEstudiantes.json();
      const secciones = await resSecciones.json();

      const opcionEstudiante = document.createElement("option");
      opcionEstudiante.value = "";
      opcionEstudiante.textContent = "Selecciona un estudiante";
      estudiantesSelect.appendChild(opcionEstudiante);

      estudiantes.forEach(e => {
        const opcion = document.createElement("option");
        opcion.value = e.id;
        opcion.textContent = `${e.cuenta || "Sin cuenta"} - ${e.nombres || ""} ${e.apellidos || ""}`.trim();
        estudiantesSelect.appendChild(opcion);
      });

      const opcionSeccion = document.createElement("option");
      opcionSeccion.value = "";
      opcionSeccion.textContent = "Selecciona una sección disponible";
      seccionesSelect.appendChild(opcionSeccion);

      secciones
        .filter(s => s.estado === "ABIERTA" && Number(s.cupos_disponibles) > 0)
        .forEach(s => {
          const opcion = document.createElement("option");
          opcion.value = s.id;
          opcion.textContent = `${s.asignatura_codigo} - ${s.asignatura_nombre} | Sección ${s.codigo} | Docente: ${s.docente_nombre} | Horario: ${s.dias} ${s.hora_inicio}-${s.hora_fin} | Cupos: ${s.cupos_disponibles}`;
          seccionesSelect.appendChild(opcion);
        });

      mensaje.textContent = estudiantes.length
        ? (seccionesSelect.options.length > 1
            ? "Selecciona los datos y pulsa Guardar matrícula."
            : "No hay secciones abiertas con cupos disponibles.")
        : "No hay estudiantes disponibles para seleccionar.";
    } catch (error) {
      mensaje.textContent = error.message;
    }
  };

  formulario.addEventListener("submit", async evento => {
    evento.preventDefault();

    if (usuarioActual?.rol !== "ADMIN") {
      mensaje.textContent = "Solo el administrador puede crear matrículas.";
      return;
    }

    const estudianteId = Number(estudiantesSelect.value);
    const seccionId = Number(seccionesSelect.value);

    if (!estudianteId || !seccionId) {
      mensaje.textContent = "Selecciona un estudiante y una sección.";
      return;
    }

    boton.disabled = true;
    mensaje.textContent = "Guardando matrícula...";

    try {
      const respuesta = await apiFetch(`${URL_BASE_API}/matriculas`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          estudiante_id: estudianteId,
          seccion_id: seccionId
        })
      });

      const datos = await respuesta.json().catch(() => ({}));

      if (!respuesta.ok) {
        const detalle = typeof datos.detail === "string"
          ? datos.detail
          : JSON.stringify(datos.detail || datos);
        throw new Error(detalle || `No se pudo guardar la matrícula (HTTP ${respuesta.status}).`);
      }

      mensaje.textContent = "Matrícula guardada correctamente.";
      formulario.reset();
      await cargarTablaGenerica("matriculas");
      await cargarOpciones();
    } catch (error) {
      mensaje.textContent = error.message;
    } finally {
      boton.disabled = false;
    }
  });

  await cargarOpciones();
}

document.addEventListener("DOMContentLoaded", () => {
  inicializarFormularioMatricula();
});
// Formulario para crear secciones y asignar docentes.
async function inicializarFormularioSeccion() {
  const form = document.getElementById("formulario-nueva-seccion");
  if (!form || form.dataset.inicializado === "si") return;
  form.dataset.inicializado = "si";

  const $ = id => document.getElementById(id);
  const mensaje = $("mensaje-nueva-seccion");

  async function obtener(ruta) {
    const r = await apiFetch(`${URL_BASE_API}${ruta}`);
    if (!r.ok) throw new Error(`Error HTTP ${r.status} al consultar ${ruta}`);
    return await r.json();
  }

  function llenar(id, filas, texto, etiqueta, filtrar = () => true) {
    const select = $(id);
    select.replaceChildren(new Option(texto, ""));
    filas.filter(filtrar).forEach(f => {
      select.add(new Option(etiqueta(f), f.id));
    });
  }

  try {
    const [asig, doc, per, aulas] = await Promise.all([
      obtener("/asignaturas?solo_activas=true"),
      obtener("/docentes?estado=ACTIVO"),
      obtener("/periodos"),
      obtener("/aulas?solo_activas=true")
    ]);
    llenar("seccion-asignatura", asig, "Selecciona asignatura", x => `${x.codigo} - ${x.nombre}`);
    llenar("seccion-docente", doc, "Selecciona docente", x => `${x.nombres} ${x.apellidos}`);
    llenar("seccion-periodo", per, "Selecciona período", x => `${x.anio} - Período ${x.numero}`, x => Boolean(x.activo));
    llenar("seccion-aula", aulas, "Sin aula", x => `${x.codigo} - ${x.edificio} (capacidad ${x.capacidad})`);
  } catch (e) {
    mensaje.textContent = "No se pudieron cargar las listas: " + e.message;
  }

  form.addEventListener("submit", async e => {
    e.preventDefault();
    const datos = {
      codigo: $("seccion-codigo").value.trim().toUpperCase(),
      asignatura_id: Number($("seccion-asignatura").value),
      docente_id: Number($("seccion-docente").value),
      periodo_id: Number($("seccion-periodo").value),
      aula_id: $("seccion-aula").value ? Number($("seccion-aula").value) : null,
      dias: $("seccion-dias").value.trim().toUpperCase(),
      hora_inicio: $("seccion-hora-inicio").value,
      hora_fin: $("seccion-hora-fin").value,
      cupo_maximo: Number($("seccion-cupo").value),
      estado: "ABIERTA"
    };

    if (datos.hora_fin <= datos.hora_inicio) {
      mensaje.textContent = "La hora final debe ser posterior a la hora inicial.";
      return;
    }

    try {
      const r = await apiFetch(`${URL_BASE_API}/secciones`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(datos)
      });
      const resultado = await r.json().catch(() => ({}));
      if (!r.ok) {
        const detalle = resultado.detail;
        throw new Error(Array.isArray(detalle) ? detalle.map(x => x.msg).join(", ") : (detalle || `HTTP ${r.status}`));
      }
      mensaje.textContent = "Sección creada correctamente; docente asignado.";
      form.reset();
      $("seccion-cupo").value = 30;
      await cargarTablaGenerica("secciones");
    } catch (err) {
      mensaje.textContent = "No se pudo guardar: " + err.message;
    }
  });
}


// FORMULARIOS DE CARRERAS, PERIODOS Y AULAS
function conectarFormularioCatalogo(config) {
  const formulario = document.getElementById(config.formulario);
  const mensaje = document.getElementById(config.mensaje);

  if (!formulario || formulario.dataset.inicializado === "si") return;
  formulario.dataset.inicializado = "si";

  formulario.addEventListener("submit", async evento => {
    evento.preventDefault();

    if (usuarioActual?.rol !== "ADMIN") {
      mensaje.textContent = "Solo el administrador puede registrar estos datos.";
      return;
    }

    const boton = formulario.querySelector('button[type="submit"]');
    boton.disabled = true;
    mensaje.textContent = "Guardando...";

    try {
      const valores = config.leer();
      const respuesta = await apiFetch(`${URL_BASE_API}${config.url}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(valores)
      });

      const datos = await respuesta.json().catch(() => ({}));

      if (!respuesta.ok) {
        const detalle = typeof datos.detail === "string"
          ? datos.detail
          : JSON.stringify(datos.detail || datos);
        throw new Error(detalle || `Error HTTP ${respuesta.status}`);
      }

      mensaje.textContent = "Registro guardado correctamente.";
      formulario.reset();

      await cargarTablaGenerica(config.tipo);
    } catch (error) {
      mensaje.textContent = "No se pudo guardar: " + error.message;
    } finally {
      boton.disabled = false;
    }
  });
}

