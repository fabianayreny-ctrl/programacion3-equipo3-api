async function apiFetch(url, opciones = {}) {
  const token =
    usuarioActual?.access_token ||
    localStorage.getItem("token_academico");

  const encabezados = new Headers(opciones.headers || {});

  if (token) {
    encabezados.set("Authorization", `Bearer ${token}`);
  }

  return fetch(url, {
    ...opciones,
    headers: encabezados,
  });
}
