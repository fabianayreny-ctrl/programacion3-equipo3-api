              <th>Segundo parcial</th>
              <th>Tercer parcial</th>
              <th>Nota final</th>
              <th>Resultado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="cuerpo-tabla-calificaciones"></tbody>
        </table>
      </div>

      <p id="texto-sin-calificaciones" class="texto-vacio oculto">
        No hay calificaciones para mostrar.
      </p>
    </section>
  </div>

  <div id="modulo-matriculas" class="oculto">
    <section id="panel-nueva-matricula" class="tarjeta">
      <h2>Nueva matrÃƒÆ’Ã‚Â­cula</h2>
      <p class="texto-ayuda-modulo">Selecciona al estudiante y la secciÃƒÆ’Ã‚Â³n en la que se matricularÃƒÆ’Ã‚Â¡.</p>
      <form id="formulario-nueva-matricula">
        <label for="matricula-estudiante">Estudiante</label>
        <select id="matricula-estudiante" required>
          <option value="">Cargando estudiantes...</option>
        </select>

        <label for="matricula-seccion">Asignatura y secciÃƒÆ’Ã‚Â³n</label>
        <select id="matricula-seccion" required>
          <option value="">Cargando secciones...</option>
        </select>

        <button type="submit" class="boton-principal" id="boton-guardar-matricula">Guardar matrÃƒÆ’Ã‚Â­cula</button>
        <p id="mensaje-nueva-matricula" class="texto-ayuda-modulo" role="status"></p>
      </form>
    </section>
    <section class="tarjeta tarjeta-tabla"><div class="encabezado-tarjeta"><h2>MatrÃƒÆ’Ã‚Â­culas registradas</h2><button type="button" class="boton-secundario" data-recargar="matriculas">Actualizar</button></div><p class="texto-ayuda-modulo">Consulta la relaciÃƒÆ’Ã‚Â³n entre estudiante, asignatura, secciÃƒÆ’Ã‚Â³n y perÃƒÆ’Ã‚Â­odo.</p><div class="contenedor-tabla"><table><thead><tr><th>Cuenta</th><th>Estudiante</th><th>Asignatura</th><th>SecciÃƒÆ’Ã‚Â³n</th><th>PerÃƒÆ’Ã‚Â­odo</th><th>Fecha</th><th>Estado</th></tr></thead><tbody id="tabla-matriculas"></tbody></table></div><p id="vacio-matriculas" class="texto-vacio oculto">No hay matrÃƒÆ’Ã‚Â­culas registradas.</p></section>
  </div>
 
<div id="modulo-secciones" class="oculto">
  <section class="tarjeta">
    <h2>Asignar asignatura a docente</h2>
    <p class="texto-ayuda-modulo">
      Completa los datos para crear una secciÃƒÆ’Ã‚Â³n acadÃƒÆ’Ã‚Â©mica.
    </p>

    <form id="formulario-nueva-seccion">
      <label for="seccion-codigo">CÃƒÆ’Ã‚Â³digo de secciÃƒÆ’Ã‚Â³n</label>
      <input id="seccion-codigo" type="text" maxlength="10"
             placeholder="Ejemplo: IS101-A" required>

      <label for="seccion-asignatura">Asignatura</label>
      <select id="seccion-asignatura" required>
        <option value="">Cargando asignaturas...</option>
      </select>

      <label for="seccion-docente">Docente asignado</label>
      <select id="seccion-docente" required>
        <option value="">Cargando docentes...</option>
      </select>

      <label for="seccion-periodo">PerÃƒÆ’Ã‚Â­odo acadÃƒÆ’Ã‚Â©mico</label>
      <select id="seccion-periodo" required>
        <option value="">Cargando perÃƒÆ’Ã‚Â­odos...</option>
      </select>

      <label for="seccion-aula">Aula (opcional)</label>
      <select id="seccion-aula">
        <option value="">Sin aula asignada</option>
      </select>

      <label for="seccion-dias">DÃƒÆ’Ã‚Â­as de clase</label>
      <input id="seccion-dias" type="text"
             placeholder="Ejemplo: LU-MI" maxlength="30" required>

      <label for="seccion-hora-inicio">Hora de inicio</label>
