</div>

<div id="modulo-carreras" class="oculto">
  
<section class="tarjeta oculto" id="tarjeta-formulario-carrera">
  <h2>Registrar carrera</h2>
  <form id="formulario-nueva-carrera">
    <label for="carrera-codigo">CÃƒÂ³digo</label>
    <input id="carrera-codigo" required minlength="2" maxlength="10" placeholder="Ejemplo: IS">
    <label for="carrera-nombre">Nombre de la carrera</label>
    <input id="carrera-nombre" required minlength="4" maxlength="120" placeholder="IngenierÃƒÂ­a en Sistemas">
    <label for="carrera-duracion">DuraciÃƒÂ³n en aÃƒÂ±os</label>
    <input id="carrera-duracion" type="number" min="1" max="10" value="5" required>
    <button type="submit" class="boton-principal">Guardar carrera</button>
