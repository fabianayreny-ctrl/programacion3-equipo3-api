    <p id="mensaje-nuevo-periodo"></p>
  </form>
</section>
<section class="tarjeta tarjeta-tabla">
    <div class="encabezado-tarjeta">
      <h2>PerÃƒÆ’Ã‚Â­odos acadÃƒÆ’Ã‚Â©micos</h2>
      <button type="button" class="boton-principal" onclick="document.getElementById('tarjeta-formulario-periodo').classList.toggle('oculto')">+ Nuevo perÃƒÆ’Ã‚Â­odo</button>
      <button type="button" class="boton-secundario" data-recargar="periodos">Actualizar</button>
    </div>
    <div class="contenedor-tabla">
      <table>
