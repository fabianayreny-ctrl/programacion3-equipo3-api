      <label for="seccion-hora-fin">Hora de finalizaciÃƒÆ’Ã‚Â³n</label>
      <input id="seccion-hora-fin" type="time" required>

      <label for="seccion-cupo">Cupo mÃƒÆ’Ã‚Â¡ximo</label>
