    </form>
  </section>

  <section class="tarjeta tarjeta-tabla">
    <div class="encabezado-tarjeta">
      <h2>Secciones acadÃƒÆ’Ã‚Â©micas</h2>
      <button type="button" class="boton-secundario"
              data-recargar="secciones">Actualizar</button>
    </div>

    <div class="contenedor-tabla">
      <table>
        <thead>
          <tr>
            <th>CÃƒÆ’Ã‚Â³digo</th>
            <th>Asignatura</th>
            <th>Docente</th>
            <th>PerÃƒÆ’Ã‚Â­odo</th>
            <th>Horario</th>
            <th>Cupos</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody id="tabla-secciones"></tbody>
      </table>
    </div>

    <p id="vacio-secciones" class="texto-vacio oculto">
      No hay secciones registradas.
    </p>
  </section>
</div>

<div id="modulo-periodos" class="oculto">
  
<section class="tarjeta oculto" id="tarjeta-formulario-periodo">
  <h2>Registrar perÃƒÂ­odo acadÃƒÂ©mico</h2>
  <form id="formulario-nuevo-periodo">
    <label for="periodo-anio">AÃƒÂ±o</label>
    <input id="periodo-anio" type="number" min="2020" max="2100" value="2026" required>
    <label for="periodo-numero">NÃƒÂºmero de perÃƒÂ­odo</label>
    <select id="periodo-numero" required>
      <option value="1">PerÃƒÂ­odo 1</option>
      <option value="2">PerÃƒÂ­odo 2</option>
