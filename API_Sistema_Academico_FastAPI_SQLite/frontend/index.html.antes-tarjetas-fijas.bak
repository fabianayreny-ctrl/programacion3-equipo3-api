    <p id="mensaje-nuevo-periodo"></p>
  </form>
</section>

<section class="tarjeta oculto" id="tarjeta-formulario-periodo">
  <h2>Registrar perÃ­odo acadÃ©mico</h2>
  <form id="formulario-nuevo-periodo">
    <label for="periodo-anio">AÃ±o</label>
    <input id="periodo-anio" type="number" min="2020" max="2100" value="2026" required>
    <label for="periodo-numero">NÃºmero de perÃ­odo</label>
    <select id="periodo-numero" required>
      <option value="1">PerÃ­odo 1</option>
      <option value="2">PerÃ­odo 2</option>
