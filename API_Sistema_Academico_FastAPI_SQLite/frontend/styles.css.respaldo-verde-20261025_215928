/* ============== DISEÑO ELEGANTE RG ============== */
:root {
  --rg-azul: #244a78;
  --rg-azul-oscuro: #172d4d;
  --rg-celeste: #eaf2fb;
  --rg-borde: #dce5f0;
  --rg-texto: #243247;
  --rg-sombra: 0 8px 24px rgba(26, 48, 78, .08);
}

body {
  color: var(--rg-texto);
  background: #f3f6fb;
}

.barra-superior {
  background: linear-gradient(120deg, #172d4d, #2d5d91);
  color: #fff;
  border-radius: 0 0 20px 20px;
  padding: 24px;
  box-shadow: var(--rg-sombra);
}

.barra-superior h1 {
  color: #fff;
  letter-spacing: -.4px;
}

.tarjeta,
.tarjeta-kpi,
.tarjeta-login,
.tarjeta-calificacion {
  border: 1px solid var(--rg-borde);
  border-radius: 16px;
  box-shadow: var(--rg-sombra);
}

.tarjeta,
.tarjeta-kpi {
  transition: box-shadow .2s ease, transform .2s ease;
}

.tarjeta-kpi:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(26, 48, 78, .12);
}

button {
  border-radius: 9px;
  transition: filter .2s ease, transform .2s ease;
}

button:hover {
  filter: brightness(.96);
}

.navegacion-modulos {
  gap: 10px;
  margin: 18px 0;
}

.boton-modulo {
  border-radius: 10px;
  font-weight: 600;
}

.boton-modulo.activo {
  background: var(--rg-azul);
  color: #fff;
  box-shadow: 0 4px 12px rgba(36, 74, 120, .2);
}

input,
select,
textarea {
  border-radius: 9px;
}

table {
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
}

thead th {
  background: var(--rg-celeste);
  color: var(--rg-azul-oscuro);
  font-weight: 700;
}

tbody tr:hover {
  background: #f7faff;
}

.tarjetas-calificaciones {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0;
}

.tarjeta-calificacion {
  background: #fff;
  padding: 20px;
  min-width: 0;
}

.tarjeta-calificacion h3 {
  color: var(--rg-azul-oscuro);
  font-size: 1rem;
  margin: 0 0 16px;
}

.tarjeta-calificacion .notas {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.tarjeta-calificacion .nota-item {
  background: #f1f5fa;
  border: 1px solid #e5ebf3;
  border-radius: 11px;
  padding: 13px;
  min-width: 0;
}

.tarjeta-calificacion .nota-item span {
  display: block;
  color: #64748b;
  font-size: .78rem;
  line-height: 1.4;
  margin-bottom: 8px;
}

.tarjeta-calificacion .nota-item strong {
  color: var(--rg-azul-oscuro);
  font-size: 1.2rem;
  overflow-wrap: anywhere;
}

.tarjeta-calificacion .nota-final {
  background: #e7f5ee;
  border-color: #c6e8d5;
}

.tarjeta-calificacion .nota-final strong {
  color: #176b46;
}

@media (max-width: 650px) {
  .tarjetas-calificaciones {
    grid-template-columns: 1fr;
  }

  .barra-superior {
    padding: 18px;
  }
}
/* ============== FIN DISEÑO ELEGANTE RG ============== */

/* Rediseño visual: verde esmeralda, coral y dorado; sin azul como acento principal */
:root {
  color-scheme: light;
  --pagina: #f3f6f2;
  --superficie: #ffffff;
  --tinta-primaria: #1d2a24;
  --tinta-secundaria: #627168;
  --tinta-tenue: #7e8d83;
  --borde: rgba(31, 62, 45, .12);
  --linea: #e2e9e2;
  --acento: #259447;
  --acento-oscuro: #176c34;
  --acento-suave: #e5f6e9;
  --estado-bueno: #218838;
  --estado-bueno-fondo: #e4f6e8;
  --estado-alerta: #b87908;
  --estado-critico: #c83f48;
  --estado-critico-fondo: #ffebed;
}
body { background: radial-gradient(circle at top right, #e5f6e9 0, transparent 32%), var(--pagina); }
.vista-dashboard { min-height: 100vh; }
.barra-superior { background: linear-gradient(115deg,#228b3e,#47ad4e 68%,#77c65b); color:#fff; border-radius:0 0 22px 22px; padding:26px clamp(18px,4vw,48px); box-shadow:0 12px 30px #287c3b25; }
.barra-superior .etiqueta,.barra-superior .chip-usuario { color:#fff; }
.contenido { max-width:1500px; margin:0 auto; padding:24px clamp(14px,3vw,36px) 42px; }
.tarjeta,.tarjeta-login { border:1px solid var(--borde); border-radius:18px; box-shadow:0 8px 28px rgba(25,65,39,.055); }
.tarjeta { padding:22px; margin:0 0 20px; }
.boton-modulo { border:1px solid transparent; border-radius:11px; padding:11px 16px; background:#e7eee8; color:#405448; font-weight:650; transition:all .18s ease; }
.boton-modulo:hover { background:#d8f0dd; transform:translateY(-1px); }
.boton-modulo.activo { background:linear-gradient(135deg,#258f43,#43ad4f); color:white; box-shadow:0 5px 14px #258f4330; }
.navegacion-modulos { display:flex; flex-wrap:wrap; gap:9px; margin:20px 0; }
button { border-radius:10px; font-weight:650; transition:filter .15s,transform .15s; }
button:hover { filter:brightness(.97); }
input,select { border-radius:9px; border-color:#d7e2d8; }
input:focus,select:focus { outline:3px solid #35a85325; border-color:#36a451; }
table { width:100%; border-collapse:separate; border-spacing:0; }
thead th { background:#eaf5ec; color:#345642; font-size:12px; text-transform:uppercase; letter-spacing:.035em; }
th,td { padding:13px 14px; border-bottom:1px solid #e8eee8; text-align:left; }
tbody tr:hover { background:#f6fbf6; }
.contenedor-tabla { overflow-x:auto; border:1px solid #e5ece5; border-radius:12px; }
.encabezado-tarjeta { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:16px; }
.texto-ayuda-modulo { color:var(--tinta-secundaria); }
.acciones-barra { display:flex; gap:9px; flex-wrap:wrap; }
.acciones-barra .boton-secundario { background:#ffffff20; color:#fff; border:1px solid #ffffff70; }
@media(max-width:700px){ .barra-superior{padding:22px 16px} .contenido{padding:16px 10px 30px} .tarjeta{padding:14px} .navegacion-modulos{gap:6px} .boton-modulo{padding:9px 11px;font-size:13px} th,td{padding:10px;font-size:13px} }
.boton-peligro { background:#fff0f0 !important; color:#b4232f !important; border:1px solid #f3c4c7 !important; margin-top:5px; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --acento: #36a852;
    --acento-oscuro: #8bd99a;
    --acento-suave: #173b23;
  }
}
